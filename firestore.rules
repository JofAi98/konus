rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner's account can read or write, and only its own folder.
    // Everything else, including any other account, is refused.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == '9Yywlv5PWVODGx48JFyHHc0tyhb2';
    }
  }
}
